@echo off
chcp 65001 >nul
title Определение сетевого адреса (IPv4)
echo ===============================================================================
echo     СЕТЕВЫЕ АДРЕСА ЭТОГО КОМПЬЮТЕРА (IPv4)
echo ===============================================================================
echo.
echo Ниже перечислены активные IPv4-адреса сетевых адаптеров:
echo.
ipconfig | findstr /i "IPv4 Адаптер Adapter"
echo.
echo ===============================================================================
echo Обратите внимание на адрес в блоке 'Беспроводная сеть' или 'Ethernet'
echo (обычно начинается на 192.168.x.x или 172.20.x.x).
echo Сообщите этот IP-адрес для запуска кластера!
echo ===============================================================================
pause
