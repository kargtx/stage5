              <CornerRadius><TopLeft>3</TopLeft><TopRight>3</TopRight><BottomRight>5</BottomRight><BottomLeft>5</BottomLeft></CornerRadius>
              <PropertyBindings isArray="true">
                <Item>
                  <PropertyName>size.height</PropertyName>
                  <DataSource>2</DataSource>
                  <DataMember>Value</DataMember>
                  <Expression>Math.max(4, Math.min(286, Math.round(x * 2.86)))</Expression>
                  <Format />
                </Item>
                <Item>
                  <PropertyName>location.y</PropertyName>
                  <DataSource>2</DataSource>
                  <DataMember>Value</DataMember>
                  <Expression>290 - Math.max(4, Math.min(286, Math.round(x * 2.86)))</Expression>
                  <Format />
                </Item>
                <Item>
                  <PropertyName>backColor</PropertyName>
                  <DataSource>2</DataSource>
                  <DataMember>Value</DataMember>
                  <Expression>x &gt; 85 ? '#EA580C' : '#0284C7'</Expression>
                  <Format />
                </Item>
              </PropertyBindings>
            </Panel>
