{UTF-8}
Доля отчислений=
	0.3
	~	
	~		|

Зарплата=
	15000
	~	
	~		|

Наличные на машину= INTEG (
	Откладываемая сумма,
		0)
	~	
	~		|

Откладываемая сумма=
	(1-Цель достигнута)*Зарплата*Доля отчислений*12
	~	
	~		|

Процентная ставка=
	IF THEN ELSE(Сбережения<=150000,0.05,IF THEN ELSE(Сбережения>150000\
		:AND:Сбережения<300000,0.8,0.1))
	~	
	~		|

Проценты=
	Сбережения*Процентная ставка
	~	
	~		|

Сбережения= INTEG (
	Проценты,
		120000)
	~	
	~		|

Цель достигнута=
	IF THEN ELSE(Наличные на машину>=300000,1,0)
	~	Dmnl
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 20
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0027
	~	Year [0,?]
	~	The time step for the simulation.
	|

