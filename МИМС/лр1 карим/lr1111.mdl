{UTF-8}
Всего сбережений=
	Сбережения в банке+Сбережения дома
	~	
	~		|

Отчисления с зарплаты=
	IF THEN ELSE (денег хватает = 0, 54000, 0)
	~	
	~		|

Сбережения дома= INTEG (
	Отчисления с зарплаты,
		0)
	~	
	~		|

Проценты=
	IF THEN ELSE (денег хватает = 0, Сбережения в банке*Процентная ставка\
		, 0)
	~	
	~		|

денег хватает=
	IF THEN ELSE (Всего сбережений>=300000, 1, 0)
	~	
	~		|

Процентная ставка=
	IF THEN ELSE(Сбережения в банке<=150000,0.05,IF THEN ELSE(Сбережения в банке\
		>150000:AND:Сбережения в банке<300000,0.8,0.1))
	~	
	~		|

Сбережения в банке= INTEG (
	Проценты,
		120000)
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 5
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.0027
	~	Year [0,?]
	~	The time step for the simulation.
	|

